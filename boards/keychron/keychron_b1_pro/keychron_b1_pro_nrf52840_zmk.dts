 *
 * SPDX-License-Identifier: MIT
 *
 * Keychron B1 Pro, US layout (PID 0x0711). The pins, the matrix, the flash
 * partitions and the battery divider come from the MIT-licensed board and
 * shield files of Keychron ZMK (app/boards/arm/keychron/keychron.dts and
 * app/boards/shields/keychron/b1/us/keychron_b1_us.overlay at commit
 * c284513085c005edf5f9a52b28c8090cc6ed01d2).
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <dt-bindings/kb1/conn_switch.h>
#include <zephyr/dt-bindings/regulator/nrf5x.h>
#include "keychron_b1_pro-layouts.dtsi"

/ {
    model = "Keychron B1 Pro";
    compatible = "keychron,b1-pro";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zmk,kscan = &kscan;
        zmk,battery = &vbatt;
        zmk,physical-layout = &layout_b1_pro_ansi;
    };

    /* 77 keys in 6 rows, then the five direct inputs (row 8): the Mac/Win
     * switch, the BT and 2.4G positions of the connection switch, and the
     * charging and charge-done signals of the charger. The cable position of
     * the connection switch has no input of its own: neither BT nor 2.4G. */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <18>;
        rows = <9>;
        map = <
            RC(3,1) RC(6,2) RC(6,3) RC(1,3) RC(3,3) RC(7,0) RC(3,6) RC(1,7) RC(6,7) RC(6,10) RC(7,10) RC(3,10) RC(5,10) RC(6,11)
            RC(6,1) RC(7,1) RC(7,2) RC(7,3) RC(7,4) RC(6,4) RC(6,5) RC(7,5) RC(7,6) RC(7,7)  RC(7,8)  RC(6,8)  RC(6,6)  RC(1,10)
            RC(1,1) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(1,4) RC(1,5) RC(0,5) RC(0,6) RC(0,7)  RC(0,8)  RC(1,8)  RC(1,6)  RC(2,10)
            RC(1,2) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(3,4) RC(3,5) RC(2,5) RC(2,6) RC(2,7)  RC(2,8)  RC(3,8)           RC(4,10)
            RC(1,15)        RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(5,4) RC(5,5) RC(4,5) RC(4,6)  RC(4,7)  RC(5,8)           RC(2,15)
            RC(6,0) RC(1,16) RC(3,9)                        RC(3,11)                 RC(5,9)  RC(2,9)  RC(5,14) RC(3,14) RC(5,11) RC(5,12)
            RC(8,0) RC(8,1) RC(8,2) RC(8,3) RC(8,4)
        >;
    };

    /* The matrix has no diodes: the stock driver makes each column an output
     * only while scanning it and filters ghosts. The same is done by
     * zmk,kb1-kscan-gpio-matrix-nodiode (src/kscan_gpio_matrix_nodiode.c).
     * wakeup-source: the key waker keeps it armed through idle sleep. */
    kscan_matrix: kscan_matrix {
        compatible = "zmk,kb1-kscan-gpio-matrix-nodiode";
        wakeup-source;
        diode-direction = "col2row";
        debounce-scan-period-ms = <4>;
        debounce-press-ms = <8>;
        debounce-release-ms = <8>;
        row-gpios
            = <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&gpio0 0 GPIO_ACTIVE_HIGH>
            , <&gpio0 1 GPIO_ACTIVE_HIGH>
            , <&gpio0 26 GPIO_ACTIVE_HIGH>
            , <&gpio0 27 GPIO_ACTIVE_HIGH>
            , <&gpio0 4 GPIO_ACTIVE_HIGH>
            , <&gpio0 5 GPIO_ACTIVE_HIGH>
            , <&gpio0 6 GPIO_ACTIVE_HIGH>
            , <&gpio0 7 GPIO_ACTIVE_HIGH>
            , <&gpio0 8 GPIO_ACTIVE_HIGH>
            , <&gpio0 11 GPIO_ACTIVE_HIGH>
            , <&gpio0 12 GPIO_ACTIVE_HIGH>
            , <&gpio0 13 GPIO_ACTIVE_HIGH>
            , <&gpio0 14 GPIO_ACTIVE_HIGH>
            , <&gpio0 15 GPIO_ACTIVE_HIGH>
            , <&gpio0 16 GPIO_ACTIVE_HIGH>
            , <&gpio0 17 GPIO_ACTIVE_HIGH>
            , <&gpio0 18 GPIO_ACTIVE_HIGH>
            , <&gpio0 20 GPIO_ACTIVE_HIGH>
            ;
    };

    /* Switch and charger inputs. While an input is active the driver polls,
     * and the switches stay active for hours: poll every 50 ms instead of every
     * 1 ms (the stock driver polled every 400 ms); a switch change registers
     * after about 150 ms. The press and release times
     * must stay above the scan period: at boot ZMK reads this kscan twice
     * before it sets the callback (resume, then enable), and ZMK's debouncer
     * counts one scan period per read, so a threshold of one period would flip
     * on the second read and call a NULL callback. Checked by
     * scripts/run-host-tests.sh on the built devicetree. */
    kscan_direct: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        debounce-scan-period-ms = <50>;
        debounce-press-ms = <150>;
        debounce-release-ms = <150>;
        input-gpios
            = <&gpio0 24 GPIO_ACTIVE_LOW>   /* Mac/Win switch: active in Win */
            , <&gpio1 8 GPIO_ACTIVE_LOW>    /* connection switch: BT */
            , <&gpio1 9 GPIO_ACTIVE_LOW>    /* connection switch: 2.4G */
            , <&gpio0 21 GPIO_ACTIVE_LOW>   /* charger: charging */
            , <&gpio0 22 GPIO_ACTIVE_LOW>   /* charger: charge done */
            ;
    };

    kscan: kscan {
        compatible = "zmk,kscan-composite";
        rows = <9>;
        columns = <18>;

        matrix {
            kscan = <&kscan_matrix>;
        };

        direct {
            kscan = <&kscan_direct>;
            row-offset = <8>;
        };
    };

    behaviors {
        /* The connection switch (see src/behavior_conn_switch.c). */
        conn_sw: conn_switch {
            compatible = "zmk,behavior-kb1-conn-switch";
            #binding-cells = <1>;
        };

        /* Indicators on the LEDs (src/behavior_kb1_indicator.c). */
        kb1_ind: kb1_indicator {
            compatible = "zmk,behavior-kb1-indicator";
            #binding-cells = <1>;
            display-name = "Indicator";
        };
    };

    /* Wake from soft off when the connection switch moves: the BT (P1.08)
     * and 2.4G (P1.09) inputs are each armed for the level opposite to the
     * one they have when the keyboard turns off (src/switch_waker.c). Both are
     * pulled high on the board. They are also direct kscan inputs; soft off
     * suspends the kscan before it arms the waker. Plugging in USB wakes the
     * nRF52840 through its VBUS detection. */
    switch_waker: switch_waker {
        compatible = "zmk,kb1-switch-waker";
        gpios = <&gpio1 8 GPIO_ACTIVE_LOW>, <&gpio1 9 GPIO_ACTIVE_LOW>;
        wakeup-source;
    };

    /* Idle sleep only: a key press wakes too (src/key_waker.c). */
    key_waker: key_waker {
        compatible = "zmk,kb1-key-waker";
        kscan = <&kscan_matrix>;
        wakeup-source;
    };

    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        /* The switch waker last: it disables the GPIOTE PORT interrupt,
         * which resuming the matrix may enable again. */
        wakeup-sources = <&key_waker &switch_waker>;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 7>;
        output-ohms = <510000>;
        full-ohms = <(510000 + 510000)>;
    };

    /* Driven by src/kb1_leds.c (meanings in include/kb1/led_logic.h). */
    status_leds: leds {
        compatible = "gpio-leds";
        led_bt: led_bt {
            gpios = <&gpio1 14 GPIO_ACTIVE_LOW>;
            label = "Bluetooth";
        };
        led_num_lock: led_num_lock {
            gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
            label = "Num Lock";
        };
        led_caps_lock: led_caps_lock {
            gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
            label = "Caps Lock";
        };
        led_24g: led_24g {
            gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
            label = "2.4G";
        };
        led_red: led_red {
            gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
            label = "Red";
        };
        led_green: led_green {
            gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
            label = "Green";
        };
        led_blue: led_blue {
            gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;
            label = "Blue";
        };
    };
};

/* The stock Keychron firmware enables the DC/DC converter of the main
 * regulator (CONFIG_BOARD_ENABLE_DCDC=y), so the board has its inductor. */
&reg1 {
    regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

zephyr_udc0: &usbd {
    status = "okay";
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        /* The Adafruit-style UF2 bootloader of the keyboard expects the
         * application at 0x1000, after the MBR (no SoftDevice). */
        sd_partition: partition@0 {
            label = "mbr";
            reg = <0x00000000 0x00001000>;
        };

        code_partition: partition@1000 {
            label = "code_partition";
            reg = <0x00001000 0x000d3000>;
        };

        storage_partition: partition@d4000 {
            label = "storage";
            reg = <0x000d4000 0x00020000>;
        };

        boot_partition: partition@f4000 {
            label = "adafruit_boot";
            reg = <0x000f4000 0x0000c000>;
        };
    };
};
