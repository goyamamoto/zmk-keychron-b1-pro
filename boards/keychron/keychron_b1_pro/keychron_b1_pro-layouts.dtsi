 *
 * Physical layout of the Keychron B1 Pro US, for ZMK Studio. Units are 1/100
 * of a key unit; the order follows default_transform. Key sizes and positions
 * are those of the B1 Pro US (PID 0x0711) in Keychron's Launcher definition
 * (app/src/launcher/875824913.json of Keychron ZMK at
 * c284513085c005edf5f9a52b28c8090cc6ed01d2), matched by matrix row and
 * column: 15 x 6.25 units, gaps in the F row, a 6.25-unit space bar and
 * half-height Up/Down keys. The last five entries stand for the direct inputs
 * (Mac/Win, BT, 2.4G, charging, charge done), drawn small below the keys.
 */

/ {
    layout_b1_pro_ansi: layout_b1_pro_ansi {
        compatible = "zmk,physical-layout";
        display-name = "B1 Pro US";
        transform = <&default_transform>;

        keys  //                       w   h    x   y rot rx ry
            = <&key_physical_attrs 100 100    0   0 0 0 0>  /*  0 RC(3,1) */,
              <&key_physical_attrs 100 100  125   0 0 0 0>  /*  1 RC(6,2) */,
              <&key_physical_attrs 100 100  225   0 0 0 0>  /*  2 RC(6,3) */,
              <&key_physical_attrs 100 100  325   0 0 0 0>  /*  3 RC(1,3) */,
              <&key_physical_attrs 100 100  425   0 0 0 0>  /*  4 RC(3,3) */,
              <&key_physical_attrs 100 100  550   0 0 0 0>  /*  5 RC(7,0) */,
              <&key_physical_attrs 100 100  650   0 0 0 0>  /*  6 RC(3,6) */,
              <&key_physical_attrs 100 100  750   0 0 0 0>  /*  7 RC(1,7) */,
              <&key_physical_attrs 100 100  850   0 0 0 0>  /*  8 RC(6,7) */,
              <&key_physical_attrs 100 100  975   0 0 0 0>  /*  9 RC(6,10) */,
              <&key_physical_attrs 100 100 1075   0 0 0 0>  /* 10 RC(7,10) */,
              <&key_physical_attrs 100 100 1175   0 0 0 0>  /* 11 RC(3,10) */,
              <&key_physical_attrs 100 100 1275   0 0 0 0>  /* 12 RC(5,10) */,
              <&key_physical_attrs 100 100 1400   0 0 0 0>  /* 13 RC(6,11) */,
              <&key_physical_attrs 100 100    0 125 0 0 0>  /* 14 RC(6,1) */,
              <&key_physical_attrs 100 100  100 125 0 0 0>  /* 15 RC(7,1) */,
              <&key_physical_attrs 100 100  200 125 0 0 0>  /* 16 RC(7,2) */,
              <&key_physical_attrs 100 100  300 125 0 0 0>  /* 17 RC(7,3) */,
              <&key_physical_attrs 100 100  400 125 0 0 0>  /* 18 RC(7,4) */,
              <&key_physical_attrs 100 100  500 125 0 0 0>  /* 19 RC(6,4) */,
              <&key_physical_attrs 100 100  600 125 0 0 0>  /* 20 RC(6,5) */,
              <&key_physical_attrs 100 100  700 125 0 0 0>  /* 21 RC(7,5) */,
